{
  "name": "echosim",
  "private": true,
  "version": "0.2.0",
  "description": "Emergent social-simulation sandbox: engine-neutral simulation core, replaceable 2D presentation.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:regression": "vitest run tests/regression",
    "test:determinism": "vitest run tests/deterministic",
    "test:architecture": "vitest run tests/architecture",
    "test:inspector": "vitest run tests/inspector",
    "sim": "tsx apps/sim-cli/src/runner.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "vite apps/game",
    "dev:debug": "vite apps/debug-ui",
    "build:game": "cd apps/game && npx vite build",
    "build:debug-ui": "cd apps/debug-ui && npx vite build",
    "bench": "tsx tools/bench.ts",
    "soak": "tsx tools/soak.ts"
  },
  "devDependencies": {
    "@echosim/ai": "workspace:*",
    "@echosim/cognition": "workspace:*",
    "@echosim/content": "workspace:*",
    "@echosim/core": "workspace:*",
    "@echosim/inspector": "workspace:*",
    "@echosim/persistence": "workspace:*",
    "@echosim/simulation": "workspace:*",
    "@echosim/social": "workspace:*",
    "@echosim/world": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
